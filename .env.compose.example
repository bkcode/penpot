# Copy to .env for the root Compose deployment.
PENPOT_VERSION=2.18.5
PENPOT_PUBLIC_URI=http://localhost:9001
PENPOT_BIND_ADDRESS=127.0.0.1
# Generate a random master secret and a separate database password.
PENPOT_SECRET_KEY=REPLACE_WITH_RANDOM_MASTER_SECRET
PENPOT_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
# Dedicated worker account must have editor access to this team/file.
PENPOT_WORKER_TEAM_ID=REPLACE_WITH_TEAM_UUID
PENPOT_WORKER_FILE_ID=REPLACE_WITH_FILE_UUID
PENPOT_WORKER_PAGE_ID=REPLACE_WITH_INITIAL_PAGE_UUID
